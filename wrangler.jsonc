{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "1cifer-docs",
	// TODO: fill in the real 1cifer Cloudflare account_id before deploying.
	"account_id": "REPLACE_WITH_1CIFER_ACCOUNT_ID",
	"compatibility_date": "2025-06-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./worker/index.ts",
	"workers_dev": true,
	"route": {
		"pattern": "docs.1cifer.kz/*",
		"zone_name": "1cifer.kz",
	},
	"rules": [
		{ "type": "Text", "globs": ["**/__redirects"], "fallthrough": true },
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true,
	},
	"observability": {
		"enabled": true,
	},
}
